{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sticky Markdown Note",
  "version": "0.1.0",
  "identifier": "com.wlrudxo.sticky-markdown-note",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "manager",
        "title": "Sticky Markdown Note",
        "width": 380,
        "height": 720,
        "minWidth": 320,
        "minHeight": 440,
        "resizable": true,
        "devtools": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
